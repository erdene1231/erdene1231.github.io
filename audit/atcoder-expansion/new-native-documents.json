[
  {
    "source": "AtCoder",
    "ref": "typical90_ab",
    "statement": {
      "id": "statement-atcoder-typical90-ab",
      "levelKey": "intermediate",
      "order": 1,
      "category": "Problem statement",
      "title": "Тэгш өнцөгтүүдийн давхцал",
      "sections": [
        {
          "title": "Бодлогын нөхцөл",
          "blocks": [
            {
              "type": "p",
              "text": "Координатын тэнхлэгүүдтэй параллель талтай $N$ тэгш өнцөгт өгөгдөнө. $k=1,\\ldots,N$ бүрд яг $k$ тэгш өнцөгтөд багтах хэсгийн талбайг ол."
            }
          ]
        },
        {
          "title": "Оролт",
          "blocks": [
            {
              "type": "p",
              "text": "Эхний мөрөнд $N$. Дараагийн $N$ мөрөнд зүүн доод ба баруун дээд оройн $lx_i,ly_i,rx_i,ry_i$ координат өгөгдөнө."
            },
            {
              "type": "code",
              "language": "text",
              "text": "N\nlx_1 ly_1 rx_1 ry_1\n...\nlx_N ly_N rx_N ry_N\n"
            }
          ]
        },
        {
          "title": "Гаралт",
          "blocks": [
            {
              "type": "p",
              "text": "Яг $1,2,\\ldots,N$ удаа хучигдсан талбайг тус бүр нэг мөрөнд хэвлэ."
            }
          ]
        },
        {
          "title": "Хязгаарлалт",
          "blocks": [
            {
              "type": "p",
              "text": "Бүх тоон оролт бүхэл."
            },
            {
              "type": "math",
              "tex": "1\\le N\\le10^5;\\quad0\\le lx_i<rx_i\\le1000;\\quad0\\le ly_i<ry_i\\le1000."
            }
          ]
        },
        {
          "title": "Жишээ",
          "blocks": [
            {
              "type": "p",
              "text": "Энэ хувилбарт зориулан зохиосон жишээ: эхний блок оролт, дараагийн блок гаралт."
            },
            {
              "type": "code",
              "language": "text",
              "text": "2\n0 0 2 2\n1 0 3 2\n"
            },
            {
              "type": "code",
              "language": "text",
              "text": "4\n2\n"
            }
          ]
        }
      ],
      "translations": {
        "en": {
          "title": "Cluttered Paper",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "p",
                  "text": "Given $N$ axis-aligned rectangles, find the area covered by exactly $k$ rectangles for every $k=1,\\ldots,N$."
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "p",
                  "text": "Read $N$, then $N$ lines containing $lx_i,ly_i,rx_i,ry_i$, the lower-left and upper-right coordinates."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "N\nlx_1 ly_1 rx_1 ry_1\n...\nlx_N ly_N rx_N ry_N\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "p",
                  "text": "Print the areas for coverage counts $1,2,\\ldots,N$, one per line."
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "p",
                  "text": "All numeric inputs are integers."
                },
                {
                  "type": "math",
                  "tex": "1\\le N\\le10^5;\\quad0\\le lx_i<rx_i\\le1000;\\quad0\\le ly_i<ry_i\\le1000."
                }
              ]
            },
            {
              "title": "Example",
              "blocks": [
                {
                  "type": "p",
                  "text": "Original example for this restatement: input first, output second."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "2\n0 0 2 2\n1 0 3 2\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "4\n2\n"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "source": "AtCoder",
    "ref": "typical90_ac",
    "statement": {
      "id": "statement-atcoder-typical90-ac",
      "levelKey": "intermediate",
      "order": 1,
      "category": "Problem statement",
      "title": "Завсрын өндрийг шинэчлэх",
      "sections": [
        {
          "title": "Бодлогын нөхцөл",
          "blocks": [
            {
              "type": "p",
              "text": "Эхэндээ $W$ байрлалын өндөр $0$. $i$-р алхамд $[L_i,R_i]$ завсрын хамгийн их өндрөөс нэгээр их $h_i$ утгыг олж, уг завсрын бүх өндрийг $h_i$ болго. Алхам бүрийн $h_i$-г ол."
            }
          ]
        },
        {
          "title": "Оролт",
          "blocks": [
            {
              "type": "p",
              "text": "Эхний мөрөнд $W,N$. Дараагийн $N$ мөрөнд $L_i,R_i$ өгөгдөнө. Байрлал $1$-ээс эхэлнэ."
            },
            {
              "type": "code",
              "language": "text",
              "text": "W N\nL_1 R_1\n...\nL_N R_N\n"
            }
          ]
        },
        {
          "title": "Гаралт",
          "blocks": [
            {
              "type": "p",
              "text": "Алхамуудын дарааллаар $h_i$ бүрийг нэг мөрөнд хэвлэ."
            }
          ]
        },
        {
          "title": "Хязгаарлалт",
          "blocks": [
            {
              "type": "p",
              "text": "Бүх тоон оролт бүхэл."
            },
            {
              "type": "math",
              "tex": "2\\le W\\le5\\cdot10^5;\\quad1\\le N\\le250000;\\quad1\\le L_i\\le R_i\\le W."
            }
          ]
        },
        {
          "title": "Жишээ",
          "blocks": [
            {
              "type": "p",
              "text": "Энэ хувилбарт зориулан зохиосон жишээ: эхний блок оролт, дараагийн блок гаралт."
            },
            {
              "type": "code",
              "language": "text",
              "text": "5 3\n1 3\n3 5\n2 4\n"
            },
            {
              "type": "code",
              "language": "text",
              "text": "1\n2\n3\n"
            }
          ]
        }
      ],
      "translations": {
        "en": {
          "title": "Long Bricks",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "p",
                  "text": "Start with $W$ heights equal to zero. At step $i$, let $h_i$ be one plus the maximum height in $[L_i,R_i]$, then set every height in that interval to $h_i$. Report each $h_i$."
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "p",
                  "text": "Read $W,N$, followed by $N$ pairs $L_i,R_i$. Positions are indexed from $1$."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "W N\nL_1 R_1\n...\nL_N R_N\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "p",
                  "text": "Print each $h_i$ on its own line in operation order."
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "p",
                  "text": "All numeric inputs are integers."
                },
                {
                  "type": "math",
                  "tex": "2\\le W\\le5\\cdot10^5;\\quad1\\le N\\le250000;\\quad1\\le L_i\\le R_i\\le W."
                }
              ]
            },
            {
              "title": "Example",
              "blocks": [
                {
                  "type": "p",
                  "text": "Original example for this restatement: input first, output second."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "5 3\n1 3\n3 5\n2 4\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "1\n2\n3\n"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "source": "AtCoder",
    "ref": "typical90_bt",
    "statement": {
      "id": "statement-atcoder-typical90-bt",
      "levelKey": "intermediate",
      "order": 1,
      "category": "Problem statement",
      "title": "Тор дээрх хамгийн урт энгийн цикл",
      "sections": [
        {
          "title": "Бодлогын нөхцөл",
          "blocks": [
            {
              "type": "p",
              "text": "Торны `.` нүдээр зөвхөн тал нийлсэн хөрш рүү шилжинэ; `#` нүд хориотой. Эхлэл рүүгээ буцаж ирэхдээ өөр нүдийг давтахгүй, дор хаяж $3$ шилжилттэй цикл ол. Ийм циклийн ялгаатай нүдний тооны хамгийн их утгыг ол."
            }
          ]
        },
        {
          "title": "Оролт",
          "blocks": [
            {
              "type": "p",
              "text": "Эхний мөрөнд $H,W$, дараагийн $H$ мөрөнд тус бүр $W$ тэмдэгт өгөгдөнө."
            },
            {
              "type": "code",
              "language": "text",
              "text": "H W\nc_1\n...\nc_H\n"
            }
          ]
        },
        {
          "title": "Гаралт",
          "blocks": [
            {
              "type": "p",
              "text": "Хамгийн их уртыг хэвлэ. Цикл байхгүй бол $-1$ хэвлэ."
            }
          ]
        },
        {
          "title": "Хязгаарлалт",
          "blocks": [
            {
              "type": "p",
              "text": "Бүх тоон оролт бүхэл."
            },
            {
              "type": "p",
              "text": "Торны нүд бүр \".\" эсвэл \"#\"; дор хаяж нэг \".\" нүд байна."
            },
            {
              "type": "math",
              "tex": "H,W\\ge1;\\quad HW\\le16."
            }
          ]
        },
        {
          "title": "Жишээ",
          "blocks": [
            {
              "type": "p",
              "text": "Энэ хувилбарт зориулан зохиосон жишээ: эхний блок оролт, дараагийн блок гаралт."
            },
            {
              "type": "code",
              "language": "text",
              "text": "2 2\n..\n..\n"
            },
            {
              "type": "code",
              "language": "text",
              "text": "4\n"
            }
          ]
        }
      ],
      "translations": {
        "en": {
          "title": "Loop Railway Plan",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "p",
                  "text": "Use orthogonal moves between `.` cells of a grid; `#` cells are blocked. Find a closed route with at least $3$ moves that repeats no cell except its starting/ending cell. Maximize the number of distinct visited cells."
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "p",
                  "text": "Read $H,W$, then $H$ strings of length $W$."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "H W\nc_1\n...\nc_H\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "p",
                  "text": "Print the maximum cycle length, or $-1$ if no such cycle exists."
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "p",
                  "text": "All numeric inputs are integers."
                },
                {
                  "type": "p",
                  "text": "Every cell is \".\" or \"#\", and at least one cell is \".\"."
                },
                {
                  "type": "math",
                  "tex": "H,W\\ge1;\\quad HW\\le16."
                }
              ]
            },
            {
              "title": "Example",
              "blocks": [
                {
                  "type": "p",
                  "text": "Original example for this restatement: input first, output second."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "2 2\n..\n..\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "4\n"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "source": "AtCoder",
    "ref": "typical90_bw",
    "statement": {
      "id": "statement-atcoder-typical90-bw",
      "levelKey": "intermediate",
      "order": 1,
      "category": "Problem statement",
      "title": "Үржигдэхүүнд зэрэг задлах",
      "sections": [
        {
          "title": "Бодлогын нөхцөл",
          "blocks": [
            {
              "type": "p",
              "text": "Эхэндээ $N$ гэсэн ганц тоо байна. Нэг үе шатанд тухайн үеийн нийлмэл тоо бүрийг үржвэр нь өөртэй нь тэнцүү $a,b\\ge2$ хоёр тоогоор сольж болно; анхны тоонууд хэвээр үлдэнэ. Шинээр гарсан тоонууд дараагийн үеэс задрана. Бүх тоог анхны болгох хамгийн цөөн үе шат хэд вэ?"
            }
          ]
        },
        {
          "title": "Оролт",
          "blocks": [
            {
              "type": "p",
              "text": "$N$ гэсэн бүхэл тоог уншина."
            },
            {
              "type": "code",
              "language": "text",
              "text": "N\n"
            }
          ]
        },
        {
          "title": "Гаралт",
          "blocks": [
            {
              "type": "p",
              "text": "Хамгийн цөөн үе шатны тоог хэвлэ."
            }
          ]
        },
        {
          "title": "Хязгаарлалт",
          "blocks": [
            {
              "type": "p",
              "text": "Бүх тоон оролт бүхэл."
            },
            {
              "type": "math",
              "tex": "2\\le N\\le10^{12}."
            }
          ]
        },
        {
          "title": "Жишээ",
          "blocks": [
            {
              "type": "p",
              "text": "Энэ хувилбарт зориулан зохиосон жишээ: эхний блок оролт, дараагийн блок гаралт."
            },
            {
              "type": "code",
              "language": "text",
              "text": "72\n"
            },
            {
              "type": "code",
              "language": "text",
              "text": "3\n"
            }
          ]
        }
      ],
      "translations": {
        "en": {
          "title": "Magic For Balls",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "p",
                  "text": "Begin with the single integer $N$. In each round, replace every composite value by two factors $a,b\\ge2$ whose product equals it; primes remain unchanged. Newly created values can split from the next round onward. Minimize the rounds until all values are prime."
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "p",
                  "text": "Read the integer $N$."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "N\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "p",
                  "text": "Print the minimum number of rounds."
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "p",
                  "text": "All numeric inputs are integers."
                },
                {
                  "type": "math",
                  "tex": "2\\le N\\le10^{12}."
                }
              ]
            },
            {
              "title": "Example",
              "blocks": [
                {
                  "type": "p",
                  "text": "Original example for this restatement: input first, output second."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "72\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "3\n"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "source": "AtCoder",
    "ref": "typical90_ca",
    "statement": {
      "id": "statement-atcoder-typical90-ca",
      "levelKey": "intermediate",
      "order": 1,
      "category": "Problem statement",
      "title": "Хоёр матрицыг ижил болгох",
      "sections": [
        {
          "title": "Бодлогын нөхцөл",
          "blocks": [
            {
              "type": "p",
              "text": "Ижил хэмжээтэй $A,B$ матриц өгөгдөнө. Нэг үйлдлээр $A$-гийн залгаа $2\\times2$ дэд матрицын дөрвөн элементийг бүгдийг $1$-ээр нэмэх эсвэл бүгдийг $1$-ээр хасна. $A$-г $B$ болгож болох эсэх, болох бол хамгийн цөөн үйлдлийн тоог ол."
            }
          ]
        },
        {
          "title": "Оролт",
          "blocks": [
            {
              "type": "p",
              "text": "Эхний мөрөнд $H,W$. Дараа нь $A$-гийн $H$ мөр, үргэлжлүүлэн $B$-гийн $H$ мөр өгөгдөнө."
            },
            {
              "type": "code",
              "language": "text",
              "text": "H W\nA_11 ... A_1W\n...\nA_H1 ... A_HW\nB_11 ... B_1W\n...\nB_H1 ... B_HW\n"
            }
          ]
        },
        {
          "title": "Гаралт",
          "blocks": [
            {
              "type": "p",
              "text": "Боломжгүй бол `No`. Боломжтой бол эхний мөрөнд `Yes`, дараагийн мөрөнд хамгийн цөөн үйлдлийн тоог хэвлэ."
            }
          ]
        },
        {
          "title": "Хязгаарлалт",
          "blocks": [
            {
              "type": "p",
              "text": "Бүх тоон оролт бүхэл."
            },
            {
              "type": "math",
              "tex": "2\\le H,W\\le100;\\quad0\\le A_{ij},B_{ij}\\le10^5."
            }
          ]
        },
        {
          "title": "Жишээ",
          "blocks": [
            {
              "type": "p",
              "text": "Энэ хувилбарт зориулан зохиосон жишээ: эхний блок оролт, дараагийн блок гаралт."
            },
            {
              "type": "code",
              "language": "text",
              "text": "2 3\n0 0 0\n0 0 0\n2 3 1\n2 3 1\n"
            },
            {
              "type": "code",
              "language": "text",
              "text": "Yes\n3\n"
            }
          ]
        }
      ],
      "translations": {
        "en": {
          "title": "Two by Two",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "p",
                  "text": "Given equally sized matrices $A,B$, an operation adds $1$ to all four entries of a contiguous $2\\times2$ submatrix of $A$, or subtracts $1$ from all four. Decide whether $A$ can become $B$ and, if so, minimize the number of operations."
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "p",
                  "text": "Read $H,W$, then the $H$ rows of $A$, followed by the $H$ rows of $B$."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "H W\nA_11 ... A_1W\n...\nA_H1 ... A_HW\nB_11 ... B_1W\n...\nB_H1 ... B_HW\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "p",
                  "text": "Print `No` if impossible. Otherwise print `Yes`, then the minimum operation count on the next line."
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "p",
                  "text": "All numeric inputs are integers."
                },
                {
                  "type": "math",
                  "tex": "2\\le H,W\\le100;\\quad0\\le A_{ij},B_{ij}\\le10^5."
                }
              ]
            },
            {
              "title": "Example",
              "blocks": [
                {
                  "type": "p",
                  "text": "Original example for this restatement: input first, output second."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "2 3\n0 0 0\n0 0 0\n2 3 1\n2 3 1\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "Yes\n3\n"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "source": "AtCoder",
    "ref": "typical90_cc",
    "statement": {
      "id": "statement-atcoder-typical90-cc",
      "levelKey": "intermediate",
      "order": 1,
      "category": "Problem statement",
      "title": "Хоёр хэмжээсээр ойр цэгүүд",
      "sections": [
        {
          "title": "Бодлогын нөхцөл",
          "blocks": [
            {
              "type": "p",
              "text": "$N$ ширхэг $(A_i,B_i)$ цэгээс хоосон биш дэд олонлог сонго. Сонгосон ямар ч хоёр цэгийн эхний координатын зөрүүний абсолют утга болон хоёр дахь координатын зөрүүний абсолют утга тус бүр $K$-аас ихгүй байх ёстой. Сонгож болох хамгийн олон цэгийн тоог ол; давхардсан координаттай цэгүүд тусдаа тоологдоно."
            }
          ]
        },
        {
          "title": "Оролт",
          "blocks": [
            {
              "type": "p",
              "text": "Эхний мөрөнд $N,K$, дараагийн $N$ мөрөнд $A_i,B_i$ өгөгдөнө."
            },
            {
              "type": "code",
              "language": "text",
              "text": "N K\nA_1 B_1\n...\nA_N B_N\n"
            }
          ]
        },
        {
          "title": "Гаралт",
          "blocks": [
            {
              "type": "p",
              "text": "Сонгож болох цэгийн хамгийн их тоог хэвлэ."
            }
          ]
        },
        {
          "title": "Хязгаарлалт",
          "blocks": [
            {
              "type": "p",
              "text": "Бүх тоон оролт бүхэл."
            },
            {
              "type": "math",
              "tex": "1\\le N\\le2\\cdot10^5;\\quad1\\le K\\le5000;\\quad1\\le A_i,B_i\\le5000."
            }
          ]
        },
        {
          "title": "Жишээ",
          "blocks": [
            {
              "type": "p",
              "text": "Энэ хувилбарт зориулан зохиосон жишээ: эхний блок оролт, дараагийн блок гаралт."
            },
            {
              "type": "code",
              "language": "text",
              "text": "4 2\n1 1\n2 3\n3 2\n5 5\n"
            },
            {
              "type": "code",
              "language": "text",
              "text": "3\n"
            }
          ]
        }
      ],
      "translations": {
        "en": {
          "title": "Friendly Group",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "p",
                  "text": "Choose a nonempty subset of $N$ points $(A_i,B_i)$. For every selected pair, the absolute difference in each coordinate must be at most $K$. Maximize the subset size; points with identical coordinates still count separately."
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "p",
                  "text": "Read $N,K$, followed by $N$ coordinate pairs $A_i,B_i$."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "N K\nA_1 B_1\n...\nA_N B_N\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "p",
                  "text": "Print the largest possible subset size."
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "p",
                  "text": "All numeric inputs are integers."
                },
                {
                  "type": "math",
                  "tex": "1\\le N\\le2\\cdot10^5;\\quad1\\le K\\le5000;\\quad1\\le A_i,B_i\\le5000."
                }
              ]
            },
            {
              "title": "Example",
              "blocks": [
                {
                  "type": "p",
                  "text": "Original example for this restatement: input first, output second."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "4 2\n1 1\n2 3\n3 2\n5 5\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "3\n"
                }
              ]
            }
          ]
        }
      }
    }
