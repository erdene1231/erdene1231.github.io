      "translations": {
        "en": {
          "title": "Sign Up Requests",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "p",
                  "text": "Initially no usernames are registered. On day $i$, one request arrives for username $S_i$. Ignore it if that name is already registered; otherwise accept the request and register the name. Determine the days on which requests are accepted."
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "p",
                  "text": "The first line contains $N$. The next $N$ lines contain $S_1,\\ldots,S_N$ in request order."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "N\nS_1\n...\nS_N\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "p",
                  "text": "Print the accepted day numbers in increasing order. Day numbering starts at $1$. Put each accepted day on its own line."
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "p",
                  "text": "$1\\le N\\le10^5$. Each $S_i$ contains between $1$ and $15$ characters, using only lowercase English letters and digits."
                }
              ]
            },
            {
              "title": "Samples",
              "blocks": [
                {
                  "type": "p",
                  "text": "Sample 1"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "5\ne869120\natcoder\ne869120\nsquare1001\nsquare1001\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "1\n2\n4\n"
                },
                {
                  "type": "p",
                  "text": "Sample 2"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "4\ntaro\nhanako\nyuka\ntakashi\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "1\n2\n3\n4\n"
