      "translations": {
        "en": {
          "title": "Plant Planning",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "Given $N$ points $(X_i,Y_i)$, choose any location $(x,y)$ in the plane to minimize $\\sum_i(|X_i-x|+|Y_i-y|)$, the sum of Manhattan distances. The location need not be an input point.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "The input gives $N$, followed by $N$ coordinate pairs $X_i,Y_i$.",
                      "marks": []
                    }
                  ]
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "N\nX_1 Y_1\n...\nX_N Y_N\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "Print the minimum total as an integer, not the chosen coordinates. Under these constraints the optimal value is integral.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "$1\\le N\\le10^5$ and $-10^9\\le X_i,Y_i\\le10^9$. All input coordinates are integers.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
