  {
    "source": "AtCoder",
    "ref": "typical90_ch",
    "statement": {
      "id": "statement-atcoder-typical90-ch",
      "levelKey": "intermediate",
      "order": 1,
      "category": "Problem statement",
      "title": "OR нөхцөлтэй массивын тоо",
      "sections": [
        {
          "title": "Бодлогын нөхцөл",
          "blocks": [
            {
              "type": "p",
              "text": "$N$ урттай, элемент бүр нь $0\\le A_j<2^{60}$ бүхэл тоо байх массивуудыг авч үз. $Q$ нөхцөл бүрд $A_{x_i}\\mathbin{\\mathrm{OR}}A_{y_i}\\mathbin{\\mathrm{OR}}A_{z_i}=w_i$ байх ёстой. Энд OR нь битийн логик OR. Бүх нөхцөлийг хангах массивын тоог ол."
            }
          ]
        },
        {
          "title": "Оролт",
          "blocks": [
            {
              "type": "p",
              "text": "Эхний мөрөнд $N,Q$, дараагийн $Q$ мөрөнд $x_i,y_i,z_i,w_i$ өгөгдөнө. Индексүүд $1$-ээс эхэлнэ."
            },
            {
              "type": "code",
              "language": "text",
              "text": "N Q\nx_1 y_1 z_1 w_1\n...\nx_Q y_Q z_Q w_Q\n"
            }
          ]
        },
        {
          "title": "Гаралт",
          "blocks": [
            {
              "type": "p",
              "text": "Хариуг $1000000007$-д хуваасан үлдэгдлээр хэвлэ."
            }
          ]
        },
        {
          "title": "Хязгаарлалт",
          "blocks": [
            {
              "type": "p",
              "text": "Бүх тоон оролт бүхэл."
            },
            {
              "type": "math",
              "tex": "3\\le N\\le12;\\quad1\\le Q\\le50;\\quad1\\le x_i<y_i<z_i\\le N;\\quad0\\le w_i<2^{60}."
            }
          ]
        },
        {
          "title": "Жишээ",
          "blocks": [
            {
              "type": "p",
              "text": "Энэ хувилбарт зориулан зохиосон жишээ: эхний блок оролт, дараагийн блок гаралт."
            },
            {
              "type": "code",
              "language": "text",
              "text": "3 1\n1 2 3 1\n"
            },
            {
              "type": "code",
              "language": "text",
              "text": "7\n"
            }
          ]
        }
      ],
      "translations": {
        "en": {
          "title": "Snuke's Favorite Arrays",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "p",
                  "text": "Count length-$N$ integer arrays with $0\\le A_j<2^{60}$ satisfying every constraint $A_{x_i}\\mathbin{\\mathrm{OR}}A_{y_i}\\mathbin{\\mathrm{OR}}A_{z_i}=w_i$, where OR is bitwise OR."
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "p",
                  "text": "Read $N,Q$, then $Q$ quadruples $x_i,y_i,z_i,w_i$. Indices start at $1$."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "N Q\nx_1 y_1 z_1 w_1\n...\nx_Q y_Q z_Q w_Q\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "p",
                  "text": "Print the count modulo $1000000007$."
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "p",
                  "text": "All numeric inputs are integers."
                },
                {
                  "type": "math",
                  "tex": "3\\le N\\le12;\\quad1\\le Q\\le50;\\quad1\\le x_i<y_i<z_i\\le N;\\quad0\\le w_i<2^{60}."
                }
              ]
            },
            {
              "title": "Example",
              "blocks": [
                {
                  "type": "p",
                  "text": "Original example for this restatement: input first, output second."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "3 1\n1 2 3 1\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "7\n"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "source": "AtCoder",
    "ref": "abc005_4",
    "statement": {
      "id": "statement-atcoder-abc005-4",
      "levelKey": "intermediate",
      "order": 1,
      "category": "Problem statement",
      "title": "Хязгаарлагдсан талбайтай дэд матриц",
      "sections": [
        {
          "title": "Бодлогын нөхцөл",
          "blocks": [
            {
              "type": "p",
              "text": "$N\\times N$ эерэг бүхэл тоон матриц өгөгдөнө. Асуулт бүрд талбай нь $P_k$-аас ихгүй, хоосон биш, мөр баганын дагуу залгаа тэгш өнцөгт дэд матрицын элементүүдийн нийлбэрийг хамгийн их болго. Асуултууд бие даасан."
            }
          ]
        },
        {
          "title": "Оролт",
          "blocks": [
            {
              "type": "p",
              "text": "Эхний мөрөнд $N$, дараагийн $N$ мөрөнд $D_{ij}$ элементүүд өгөгдөнө. Дараа нь $Q$, үргэлжлүүлэн тус бүр $P_k$ гэсэн $Q$ мөр ирнэ."
            },
            {
              "type": "code",
              "language": "text",
              "text": "N\nD_11 ... D_1N\n...\nD_N1 ... D_NN\nQ\nP_1\n...\nP_Q\n"
            }
          ]
        },
        {
          "title": "Гаралт",
          "blocks": [
            {
              "type": "p",
              "text": "Асуулт бүрийн хамгийн их нийлбэрийг нэг мөрөнд хэвлэ."
            }
          ]
        },
        {
          "title": "Хязгаарлалт",
          "blocks": [
            {
              "type": "p",
              "text": "Бүх тоон оролт бүхэл."
            },
            {
              "type": "math",
              "tex": "1\\le N\\le50;\\quad1\\le D_{ij}\\le100;\\quad1\\le Q\\le N^2;\\quad1\\le P_k\\le N^2."
            }
          ]
        },
        {
          "title": "Жишээ",
          "blocks": [
            {
              "type": "p",
              "text": "Энэ хувилбарт зориулан зохиосон жишээ: эхний блок оролт, дараагийн блок гаралт."
            },
            {
              "type": "code",
              "language": "text",
              "text": "2\n1 2\n3 4\n3\n1\n2\n4\n"
            },
            {
              "type": "code",
              "language": "text",
              "text": "4\n7\n10\n"
            }
          ]
        }
      ],
      "translations": {
        "en": {
          "title": "ABC005 D",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "p",
                  "text": "Given a positive integer $N\\times N$ matrix, each independent query asks for the maximum sum of a nonempty contiguous axis-aligned rectangular submatrix with area at most $P_k$."
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "p",
                  "text": "Read $N$, then $N$ matrix rows $D_{ij}$. Read $Q$, followed by $Q$ lines containing $P_k$."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "N\nD_11 ... D_1N\n...\nD_N1 ... D_NN\nQ\nP_1\n...\nP_Q\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "p",
                  "text": "Print the maximum sum for each query, one per line."
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "p",
                  "text": "All numeric inputs are integers."
                },
                {
                  "type": "math",
                  "tex": "1\\le N\\le50;\\quad1\\le D_{ij}\\le100;\\quad1\\le Q\\le N^2;\\quad1\\le P_k\\le N^2."
                }
              ]
            },
            {
              "title": "Example",
              "blocks": [
                {
                  "type": "p",
                  "text": "Original example for this restatement: input first, output second."
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "2\n1 2\n3 4\n3\n1\n2\n4\n"
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "4\n7\n10\n"
                }
              ]
            }
          ]
        }
      }
    }
  }
