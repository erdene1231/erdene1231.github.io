          ]
        }
      ],
      "translations": {
        "en": {
          "title": "Independent Set on a Tree",
          "sections": [
            {
              "title": "Task",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "An undirected tree has vertices numbered from $1$ to $N$. Select exactly $N/2$ distinct vertices such that no edge directly joins two selected vertices. Output one such selection.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "title": "Input",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "The first line contains $N$. Each of the next $N-1$ lines contains the endpoints $A_i,B_i$ of an undirected edge.",
                      "marks": []
                    }
                  ]
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "N\nA_1 B_1\n...\nA_{N-1} B_{N-1}\n"
                }
              ]
            },
            {
              "title": "Output",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "Print exactly $N/2$ distinct vertex numbers on one space-separated line. Any valid selection is accepted, and its numbers may be printed in any order.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "title": "Constraints",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "$2\\le N\\le100000$; $N$ is even; $1\\le A_i<B_i\\le N$ for each edge. The input graph is a tree. All input values are integers.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "title": "Samples",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "Sample 1 — Input",
                      "marks": []
                    }
                  ]
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "4\n1 2\n2 3\n2 4\n"
                },
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "Output",
                      "marks": []
                    }
                  ]
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "3 4\n"
                },
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "Sample 2 — Input",
                      "marks": []
                    }
                  ]
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "6\n1 3\n2 4\n3 5\n2 5\n3 6\n"
                },
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "Output",
                      "marks": []
                    }
                  ]
                },
                {
                  "type": "code",
                  "language": "text",
                  "text": "1 2 6\n"
                },
                {
                  "type": "rich",
                  "content": [
                    {
                      "text": "Only direct adjacency is forbidden; a longer path between selected vertices is allowed. Output the selected vertex numbers, not a bitmask or a maximum-set size.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            {
              "title": "Attribution",
              "blocks": [
                {
                  "type": "rich",
                  "content": [
